%% wadelab.sty -- the shared preamble for the safe-tre-agent and OPACITY papers.
%%
%% One copy lives in each repository (safe-tre-agent/paper/ and
%% opacity/paper/) and the two must stay byte-identical: change it in one,
%% copy it to the other in the same sitting, and say so in both commit
%% messages. Venue-neutral on purpose: the body of a paper lives in
%% sections/*.tex and is \input by a thin wrapper, so moving to a venue class
%% (an ACM or PoPETs template) swaps the wrapper and leaves the body alone.
%%
%% What it fixes: page, type, headings, running head, title block, abstract,
%% lists, tables, captions, citations, links, and a handful of semantic
%% macros so that both papers typeset the same thing the same way. What it
%% does not do: define any number. Numbers come from a generated numbers.tex
%% (see STYLE.md).
%%
%% Interface used by main.tex: \title, \author, \preprintline{...} (the small
%% line under the authors), \shorttitle{...} (the running head), and the
%% standard abstract environment.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{wadelab}[2026/10/28 v2.1 shared preprint style for the Wade lab papers]

% ---- page -------------------------------------------------------------------
% A measure of about 75 characters a line at 11 pt, which is where long
% technical prose reads best; the margins are what is left of A4.
\RequirePackage[a4paper,textwidth=148mm,textheight=232mm,top=27mm,
                headheight=14pt,headsep=8mm,footskip=11mm]{geometry}
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\setlength{\parindent}{1.2em}
\setlength{\parskip}{0pt plus 1pt}
\setlength{\emergencystretch}{1.5em}

% ---- type -------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{libertine}             % Linux Libertine (text) and Biolinum (sans)
\RequirePackage{libertinust1math}      % the matching mathematics
\RequirePackage[varqu,varl,scaled=0.94]{inconsolata}   % code
\RequirePackage{microtype}
\frenchspacing
\RequirePackage{amsmath}
\RequirePackage{graphicx}
\graphicspath{{figures/}}
\RequirePackage{xcolor}
% The figure palette (figures/wadelab.mplstyle), for headings and diagrams.
\definecolor{wlblue}{HTML}{33608C}
\definecolor{wlorange}{HTML}{D08C34}
\definecolor{wlgreen}{HTML}{4F8C6B}
\definecolor{wlred}{HTML}{A34E5E}
\definecolor{wlpurple}{HTML}{6E5B8E}
\definecolor{wlgrey}{HTML}{8A8578}
\definecolor{wllight}{HTML}{BFBDB6}
\definecolor{wlink}{HTML}{17202A}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,fit,backgrounds,calc}

% ---- headings ---------------------------------------------------------------
\RequirePackage{titlesec}
\titleformat{\section}
  {\Large\sffamily\bfseries\color{wlink}}{\textcolor{wlblue}{\thesection}}{0.7em}{}
\titleformat{\subsection}
  {\large\sffamily\bfseries\color{wlink}}{\textcolor{wlblue}{\thesubsection}}{0.7em}{}
\titleformat{\subsubsection}
  {\normalsize\sffamily\bfseries\color{wlink}}{\textcolor{wlblue}{\thesubsubsection}}{0.7em}{}
\titleformat{\paragraph}[runin]
  {\normalsize\sffamily\bfseries\color{wlink}}{}{0pt}{}
\titlespacing*{\section}{0pt}{20pt plus 4pt minus 2pt}{8pt plus 1pt}
\titlespacing*{\subsection}{0pt}{14pt plus 3pt minus 2pt}{5pt plus 1pt}
\titlespacing*{\subsubsection}{0pt}{10pt plus 2pt minus 1pt}{3pt}
\titlespacing*{\paragraph}{0pt}{8pt plus 2pt minus 1pt}{0.7em}

% ---- running head -----------------------------------------------------------
\RequirePackage{fancyhdr}
\newcommand{\wl@shorttitle}{}
\newcommand{\shorttitle}[1]{\renewcommand{\wl@shorttitle}{#1}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\sffamily\color{wlgrey}\wl@shorttitle}
\fancyhead[R]{\footnotesize\sffamily\color{wlgrey}\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\sffamily\color{wlgrey}\thepage}}

% ---- title block ------------------------------------------------------------
\RequirePackage{titling}
\setlength{\droptitle}{-2.2em}
\pretitle{\begin{center}\LARGE\sffamily\bfseries\color{wlink}}
\posttitle{\par\end{center}\vskip 0.4em}
\preauthor{\begin{center}\normalsize\lineskip 0.4em\begin{tabular}[t]{c}}
\postauthor{\end{tabular}\par\end{center}}
\predate{\begin{center}\footnotesize\sffamily\color{wlgrey}}
\postdate{\par\end{center}\vskip -0.3em{\centering\textcolor{wllight}{\rule{0.28\textwidth}{0.4pt}}\par}\vskip 0.2em}
% \preprintline{...} sets the small line under the authors: date, status,
% version and commit. Keep it to one or two lines.
\newcommand{\preprintline}[1]{\date{#1}}

% ---- abstract ---------------------------------------------------------------
\renewenvironment{abstract}{%
  \vskip 0.6em
  {\centering\small\sffamily\bfseries\textcolor{wlblue}{\abstractname}\par}
  \vskip 0.3em
  \begin{list}{}{\leftmargin=9mm\rightmargin=9mm\listparindent=0pt\parsep=0pt\topsep=0pt}
  \item\relax\small}
 {\end{list}\vskip 0.8em}

% ---- lists, tables, captions ---------------------------------------------
\RequirePackage{enumitem}
\setlist{leftmargin=*,itemsep=2pt,topsep=3pt,parsep=0pt}
\RequirePackage{booktabs}
\RequirePackage{threeparttable}
% ---- glossary --------------------------------------------------------------
% Both papers end with a glossary before the references:
%   \begin{glossarylist} \gterm{term}{definition} ... \end{glossarylist}
% Terms in alphabetical order; a term the two papers share has the same
% definition in both (STYLE.md lists them).
\newenvironment{glossarylist}
  {\begin{description}[style=unboxed,leftmargin=0pt,itemsep=3pt,parsep=0pt,topsep=4pt,
                       font=\normalfont\sffamily\bfseries,labelsep=0.6em]\small}
  {\end{description}}
\newcommand{\gterm}[2]{\item[#1] #2}
\RequirePackage{array}
\renewcommand{\arraystretch}{1.12}
\setlength{\tabcolsep}{5pt}
\RequirePackage[font=small,labelfont={bf,sf},labelsep=period,
                width=0.94\textwidth,skip=6pt]{caption}
\captionsetup[table]{position=above,skip=5pt}
\renewcommand{\thefootnote}{\arabic{footnote}}

% ---- citations and links ---------------------------------------------------
% Numeric citations, compressed ranges, plainnat so \citet works in prose.
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage{xurl}
\RequirePackage[colorlinks=true,linkcolor=wlblue,citecolor=wlblue,urlcolor=wlblue,
                breaklinks=true]{hyperref}

% ---- semantic macros -------------------------------------------------------
% Use these rather than raw \texttt/\emph so the two papers agree.
\newcommand{\code}[1]{\texttt{#1}}          % an identifier in code
\newcommand{\clause}[1]{\textsc{\MakeLowercase{#1}}}  % a specification clause: \clause{P19}
\newcommand{\sys}[1]{\textit{#1}}           % a system name: \sys{safe-tre-agent}, \sys{OPACITY}
\newcommand{\term}[1]{\emph{#1}}            % a defined term at its first use
\newcommand{\level}[1]{s#1}                 % an OPACITY disclosure level: \level{3}
\newcommand{\tbd}{\textsc{tbd}}             % a value the build has not generated yet

% ---- floats ----------------------------------------------------------------
\renewcommand{\topfraction}{0.9}
\renewcommand{\textfraction}{0.07}
\setcounter{topnumber}{3}

\endinput
